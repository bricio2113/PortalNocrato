rules_version = '2';

// Regras de seguranca do Portal do Cliente - Agencia Nocrato.
//
// Modelo de dados:
//   usuarios/{uid}                    { email, role: 'agencia'|'cliente', empresaId }
//   empresas/{empresaId}              { nome }
//     events/{id} | kanban_tasks/{id} | tasks/{id} | drive_links/{id}
//     _meta/seed                      { events: bool, tasks: bool }
//     relatorios/{aaaa-mm}            { resumo, destaques, alcance, ... }
//
// _meta/seed registra que os dados de exemplo ja foram inseridos, para nao
// reaparecerem depois que o cliente apaga tudo. Fica em subcolecao porque o
// documento da empresa e restrito a agencia, e quem semeia e o proprio cliente.
//
// Principio: o cliente so enxerga e escreve dentro da propria empresa;
// a agencia enxerga tudo; ninguem promove a si mesmo a 'agencia'.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Espelha a checagem de emailVerified feita em App.tsx.
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // ADMINISTRADORES. Precisa ficar igual a ADMIN_EMAILS em constants.ts.
    //
    // Duas funcoes: bootstrap (o primeiro admin precisa conseguir criar o
    // proprio documento com role 'agencia') e poder administrativo.
    //
    // Por que a lista fica aqui e nao num campo do documento: um `isAdmin:
    // true` em usuarios/{uid} exigiria uma regra protegendo esse campo
    // especifico, e um esquecimento ali reabre a escalacao de privilegio. Esta
    // lista nenhum SDK escreve.
    function isAdminEmail() {
      return isSignedIn() && request.auth.token.email in [
        'pedro.vidal2608@gmail.com',
        'briciomarketing@gmail.com'
      ];
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    // EQUIPE DA AGENCIA: admin ou colaborador. Da acesso ao trabalho de
    // conteudo em todos os clientes - calendario, producao, aprovacao,
    // relatorios, arquivos.
    //
    // Confiar no campo 'role' so e seguro porque as regras de
    // usuarios/{userId} impedem que o proprio usuario o altere.
    function isAgency() {
      return isAdminEmail()
        || (isVerified() && hasUserDoc() && myUserDoc().role == 'agencia');
    }

    // ADMINISTRADOR: gerencia PESSOAS e CLIENTES.
    //
    // Antes este degrau nao existia - `role: 'agencia'` dava tudo, e qualquer
    // pessoa da equipe podia se promover, mudar o vinculo de outra ou excluir
    // um cliente com os posts dentro.
    function isAdmin() {
      return isAdminEmail();
    }

    function belongsTo(empresaId) {
      return isVerified() && hasUserDoc() && myUserDoc().empresaId == empresaId;
    }

    // O cliente pode gravar a decisao dele numa publicacao, e mais nada.
    //
    // diff().affectedKeys() lista os campos que a escrita mexeu; exigimos que
    // esse conjunto caiba dentro dos tres campos de aprovacao. Assim o cliente
    // aprova sem conseguir, na mesma requisicao, mudar data, legenda, status
    // ou as metricas do post.
    function onlyApprovalChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['approval', 'approvalBy', 'approvalAt', 'approvalByName'])
             && request.resource.data.approval in ['aguardando', 'aprovado', 'ajuste_solicitado']
             && request.resource.data.approvalBy == request.auth.token.email;
    }

    // ---------------------------------------------------------------
    // usuarios/
    // ---------------------------------------------------------------

    match /usuarios/{userId} {

      // O usuario le o proprio documento; a agencia le todos (dashboard).
      allow read: if (isSignedIn() && request.auth.uid == userId)
                  || isAgency();

      // Auto-cadastro: apenas o proprio uid, sempre como cliente sem vinculo.
      // Impede que alguem nasca 'agencia' ou ja vinculado a uma empresa.
      //
      // Criar conta para outra pessoa e privilegio de admin: um colaborador
      // que pudesse criar documento arbitrario poderia se dar um segundo
      // usuario 'agencia' e contornar todo o resto.
      allow create: if isAdmin()
                    || (isSignedIn()
                        && request.auth.uid == userId
                        && request.resource.data.role == 'cliente'
                        && request.resource.data.empresaId == null);

      // O usuario pode mexer no proprio documento - nome, sobrenome, foto -,
      // mas role e empresaId ficam congelados: so a agencia os altera. Esta e
      // a regra que fecha a escalacao de privilegio.
      //
      // A foto e gravada como data URI dentro do documento. O teto de 200 KB
      // aplicado no cliente (utils/avatar.ts) e repetido aqui, porque validacao
      // que so existe no front nao e validacao: sem isto alguem poderia gravar
      // 1 MiB por documento chamando o SDK direto.
      // `cargo` entra na lista de campos congelados junto de role e empresaId.
      // Cargo define como a pessoa e vista pela equipe; quem se auto-intitula
      // "Diretor" cria confusao, nao hierarquia.
      allow update: if isAdmin()
                    || (isSignedIn()
                        && request.auth.uid == userId
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.empresaId == resource.data.empresaId
                        && request.resource.data.get('cargo', null) == resource.data.get('cargo', null)
                        && (!('fotoUrl' in request.resource.data)
                            || request.resource.data.fotoUrl == null
                            || request.resource.data.fotoUrl.size() <= 300000));

      // Remover conta e administrativo. O colaborador nao apaga colega nem
      // cliente.
      allow delete: if isAdmin();

      // DADOS FINANCEIROS DA PESSOA - subcolecao, nao campo.
      //
      // O documento usuarios/{uid} e lido pela EQUIPE INTEIRA (o painel precisa
      // listar as pessoas). Um campo `financeiro` ali dentro estaria visivel
      // para todo colaborador, e "so admin ve" seria mentira da interface: o
      // dado chegaria no navegador de quem nao deveria. O Firestore nao filtra
      // campo na leitura - quem le o documento le tudo.
      //
      // Admin ve de todos; cada pessoa ve o proprio. Escrita e so do admin:
      // ninguem edita o proprio contrato.
      match /_financeiro/{docId} {
        allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
        allow write: if isAdmin();
      }
    }

    // ---------------------------------------------------------------
    // empresas/ e subcolecoes
    // ---------------------------------------------------------------

    match /empresas/{empresaId} {

      // Cliente le a propria empresa; agencia le todas.
      //
      // ATENCAO ao que se grava neste documento: o CLIENTE LE TODOS OS CAMPOS
      // dele. `notasInternas` tem nome enganoso - nao e escondido do cliente,
      // porque o Firestore nao filtra campo na leitura. Segredo de verdade vai
      // para _financeiro/ abaixo, ou para outra subcolecao restrita.
      allow read: if isAgency() || belongsTo(empresaId);

      // Criar, renomear e excluir empresa e privilegio de ADMIN.
      //
      // Excluir a empresa e a acao mais destrutiva do sistema - leva o
      // calendario, os relatorios e o historico de aprovacao com ela -, e
      // estava liberada para qualquer conta com role 'agencia'.
      //
      // O cadastro do cliente (segmento, contato, contrato) mora neste
      // documento, entao editar ficha tambem e administrativo.
      allow write: if isAdmin();

      // events: o cliente le tudo, mas nao apaga nem cria publicacao. O papel
      // dele e aprovar ou pedir ajuste - a producao e da agencia. Antes tinha
      // escrita total e podia excluir o calendario inteiro.
      //
      // Na atualizacao o cliente so pode tocar nos campos de aprovacao e nas
      // metricas nao: titulo, data, status, links e legenda ficam congelados.
      match /events/{docId} {
        allow read: if isAgency() || belongsTo(empresaId);
        allow create, delete: if isAgency();

        allow update: if isAgency()
                      || (belongsTo(empresaId) && onlyApprovalChanged());
      }

      // post_comments: os dois lados comentam. Cada um apaga o proprio
      // comentario; a agencia apaga qualquer um (moderacao).
      match /post_comments/{docId} {
        allow read: if isAgency() || belongsTo(empresaId);

        // authorEmail e authorRole precisam refletir quem esta escrevendo,
        // senao o cliente poderia publicar um comentario assinado como agencia.
        allow create: if (isAgency() || belongsTo(empresaId))
                      && request.resource.data.authorEmail == request.auth.token.email
                      && request.resource.data.authorRole == (isAgency() ? 'agencia' : 'cliente');

        allow update: if false; // comentario nao se edita: o historico e a prova
        allow delete: if isAgency()
                      || (belongsTo(empresaId) && resource.data.authorEmail == request.auth.token.email);
      }

      // ATENCAO: as colecoes abaixo sao listadas uma por uma, sem wildcard.
      //
      // As regras do Firestore sao permissivas por uniao: se QUALQUER match
      // conceder, o acesso passa. Um `match /{subcollection}/{docId}` generico
      // aqui tambem casaria events/ e post_comments/ e devolveria a escrita
      // total ao cliente, anulando as restricoes acima em silencio.

      // Escrita e privilegio da agencia: o relatorio e entregue ao cliente,
      // nao editado por ele.
      match /relatorios/{docId} {
        allow read: if isAgency() || belongsTo(empresaId);
        allow write: if isAgency();
      }

      // SUBTAREFAS: as etapas de producao de um conteudo (roteiro, design,
      // revisao). SO A AGENCIA, nem leitura para o cliente - e a divisao interna
      // do trabalho, e mostra-la daria ao cliente um painel de cobranca sobre
      // quem da equipe esta atrasado em que.
      match /subtarefas/{docId} {
        allow read, write: if isAgency();
      }

      // kanban_tasks: MODELO ANTIGO, mantido apenas para limpeza.
      //
      // O quadro de producao lia esta colecao como se fosse a verdade, e ela era
      // um espelho de events/ - dava para criar card aqui sem post na agenda, e
      // esse card nao movia nada nem tinha conteudo. Hoje o quadro le events/
      // direto. A regra continua de pe para o app conseguir APAGAR o que sobrou.
      match /kanban_tasks/{docId} {
        allow read, write: if isAgency() || belongsTo(empresaId);
      }
      match /tasks/{docId} {
        allow read, write: if isAgency() || belongsTo(empresaId);
      }
      match /drive_links/{docId} {
        allow read, write: if isAgency() || belongsTo(empresaId);
      }
      match /_meta/{docId} {
        allow read, write: if isAgency() || belongsTo(empresaId);
      }
      // HISTORICO das publicacoes: o "andamento" que o cliente ve.
      //
      // SO ESCRITA, NUNCA EDICAO. Nao ha allow update nem delete: a serventia de
      // um historico e ser prova, e prova que se edita nao serve. Registro
      // errado se corrige com registro novo.
      //
      // `por` e `porPapel` precisam refletir quem esta escrevendo, senao o
      // cliente poderia gravar uma entrada assinada como agencia - mesma
      // protecao que post_comments tem.
      match /historico/{docId} {
        allow read: if isAgency() || belongsTo(empresaId);
        allow create: if (isAgency() || belongsTo(empresaId))
                      && request.resource.data.por == request.auth.token.email
                      && request.resource.data.porPapel == (isAgency() ? 'agencia' : 'cliente');
        allow update, delete: if false;
      }

      // MINIATURAS das publicacoes: um documento por evento, com a capa em
      // data URI de ~40 KB.
      //
      // Colecao propria, e nao campo dentro do evento, por causa de custo: o
      // subscribePendingCounts le a colecao events inteira para contar
      // pendencias, e com a miniatura la dentro cada contagem arrastaria 40 KB
      // por post - dezenas de MB por abertura do painel com 20 clientes.
      //
      // Escrita e da agencia: a miniatura e derivada do material que ela produz.
      // O cliente le, porque e o que a grade e a previa do feed exibem para ele.
      match /covers/{docId} {
        allow read: if isAgency() || belongsTo(empresaId);
        allow write: if isAgency()
                     // Teto repetido aqui: o limite de 120 KB aplicado no
                     // navegador (utils/thumbnail.ts) nao vale nada se alguem
                     // chamar o SDK direto. O documento do Firestore aceita
                     // 1 MiB, e 30 posts com 1 MiB cada seriam 30 MB por
                     // abertura de tela.
                     && request.resource.data.thumb is string
                     && request.resource.data.thumb.size() <= 200000;
      }

      // Espelho de leitura escrito pelo CalendarView.
      match /Agenciaapk/{docId} {
        allow read, write: if isAgency() || belongsTo(empresaId);
      }

      // FINANCEIRO DO CLIENTE - so admin, nem o proprio cliente.
      //
      // Mesmo motivo do _financeiro do usuario: subcolecao e a unica forma de
      // esconder do cliente, que le o documento da empresa dele por inteiro.
      // Colaborador tambem nao ve - contrato e valor nao sao dado de producao.
      match /_financeiro/{docId} {
        allow read, write: if isAdmin();
      }
    }

    // ---------------------------------------------------------------
    // CONFIGURACOES GERAIS DO APP - configuracoes/{doc}
    //
    // Hoje: configuracoes/cargos { lista: [string], atualizadoEm, atualizadoPor }
    //
    // LEITURA para qualquer pessoa autenticada, inclusive cliente. A lista de
    // cargos nao e segredo - e um vocabulario - e o portal do cliente exibe o
    // cargo de quem atende. Restringir a agencia so produziria erro de permissao
    // no console de uma tela que apenas mostra a palavra "Designer".
    //
    // ESCRITA so de admin: quem muda o vocabulario da equipe muda o significado
    // de todo cargo ja gravado nas pessoas.
    // ---------------------------------------------------------------

    match /configuracoes/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Negacao explicita para qualquer caminho nao previsto acima.
    // ---------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
